# Copy this file to .env and adjust as needed.

# Host where TWS / IB Gateway is running (usually localhost for a local desktop install)
IBKR_HOST=127.0.0.1

# "paper" -> IBKR_PAPER_PORT, "live" -> IBKR_LIVE_PORT
IBKR_TRADING_MODE=paper

# Default TWS/Gateway paper trading socket port
IBKR_PAPER_PORT=7497

# Default TWS/Gateway live trading socket port
IBKR_LIVE_PORT=7496

# Any integer not already used by another API client connected to the same TWS/Gateway instance
IBKR_CLIENT_ID=42

# How long to wait between reconnect attempts after a dropped connection
IBKR_RECONNECT_DELAY_SECONDS=5

# How often to ping TWS/Gateway to detect a stale connection
IBKR_HEARTBEAT_INTERVAL_SECONDS=10

# Comma-separated list of tickers to subscribe to on startup
DEFAULT_TICKERS=AAPL,MSFT,SPY

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173

# --- Signal engine -----------------------------------------------------
# Named, independently tunable rules — see backend/app/signals/rules.py for
# what each threshold means. Turn a rule off entirely with its _ENABLED flag.

SIGNALS_VWAP_RECLAIM_ENABLED=true
SIGNALS_VWAP_EXTENSION_PCT=0.15
SIGNALS_VWAP_LOOKBACK_BARS=5
SIGNALS_VWAP_VOLUME_WINDOW=20
SIGNALS_VWAP_VOLUME_MULTIPLIER=1.2

SIGNALS_EMA_CROSS_ENABLED=true
SIGNALS_EMA_FAST_PERIOD=9
SIGNALS_EMA_SLOW_PERIOD=20
SIGNALS_EMA_VOLUME_MULTIPLIER=1.1

SIGNALS_VOLUME_SPIKE_ENABLED=true
SIGNALS_VOLUME_SPIKE_WINDOW=20
SIGNALS_VOLUME_SPIKE_STD_DEV_THRESHOLD=2.0
SIGNALS_VOLUME_SPIKE_BREAKOUT_LOOKBACK_BARS=20

# Gates all rules above: suppresses a signal unless today's cumulative volume
# pace (at the bar's time of day) is at least this many times the average
# pace seen at the same time of day on prior sessions this process has
# observed (resets on restart — see app/signals/relative_volume.py).
SIGNALS_RELATIVE_VOLUME_FILTER_ENABLED=true
SIGNALS_RELATIVE_VOLUME_MIN_RATIO=1.0
SIGNALS_RELATIVE_VOLUME_MIN_SESSIONS=1

# --- Telegram notifications (optional) ----------------------------------
# Leave both blank to disable entirely — nothing is sent and no token is
# hardcoded anywhere in this project. To enable:
#   1. Message @BotFather on Telegram, send /newbot, and follow the prompts
#      to get a bot token.
#   2. Send your new bot any message (e.g. "hi"), then open in a browser:
#      https://api.telegram.org/bot<your-token>/getUpdates
#      and read the chat id out of the JSON response ("chat": {"id": ...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated rule names to notify on via Telegram; blank = all rules
# (vwap_reclaim, ema_cross, volume_spike_breakout)
TELEGRAM_ENABLED_RULES=

# Minimum seconds between two Telegram messages for the same ticker+rule
TELEGRAM_COOLDOWN_SECONDS=120
